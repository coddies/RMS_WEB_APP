# Copy this file to .env in this folder; do not put credentials in source control.
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8765
BRIDGE_TOKEN=replace-with-a-random-secret-at-least-32-characters
BRIDGE_SESSION_ENCRYPTION_KEY=replace-with-64-lowercase-hex-characters
BRIDGE_DATABASE=data/restaurant.sqlite

# Local development reads public Supabase config from this file or project .env.local.
# The Windows installer instead bakes the URL and public key in at build time.
RMS_SUPABASE_URL=
RMS_SUPABASE_ANON_KEY=
RMS_TENANT_SLUG=demo
RMS_WEB_APP_URL=https://your-project.vercel.app

# Set either a LAN host or the exact Windows-installed USB printer name.
PRINTER_HOST=
PRINTER_PORT=9100
# PRINTER_NAME=EPSON TM-T20III Receipt
